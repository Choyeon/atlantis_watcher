# ---------- 本地开发环境（不入库） ----------
/.venv/
/.idea/
/.vscode/
/.workbuddy/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]

# ---------- 构建产物与旧配置 ----------
/build/
/dist/
/.dist/
/fastapi_app.spec
/main.spec
/myapp.spec
/uv.lock
/log.txt
/webgui/unpackage/

# ---------- 前端工程 ----------
/frontend/node_modules/
/frontend/dist/
/frontend/shots/
/frontend/.vite/
/frontend/*.local

# Vite 产物由 npm run build 生成，不入库
/static/dist/

# ---------- 密钥与本机配置（绝不入库） ----------
.env
.env.*
!.env.example
local.properties
keystore.properties
*.keystore
*.jks
*.pfx
*.p12
